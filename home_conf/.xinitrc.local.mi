echo Xft.dpi: 192 | xrdb -merge
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_ENABLE_HIGHDPI_SCALING=1

# Caps to Ctrl
setxkbmap -option ctrl:nocaps

# Slow down of scroll by the touch pad
xinput set-prop 12 "libinput Scrolling Pixel Distance" 40

# Disable screen saver
xset s off

# Off display after 5 min (300 sec) idle
xset +dpms
xset dpms 0 0 300
